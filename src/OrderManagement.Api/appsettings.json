{
  "ConnectionStrings": {
    "OrdersDb": "Data Source=orders.db"
  },
  "Jwt": {
    "Issuer": "OrderManagement.Api",
    "Audience": "OrderManagement.Client",
    "Key": "development-only-key-change-me-in-production-2026-orders-api",
    "ExpirationMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "AllowedHosts": "*"
}
